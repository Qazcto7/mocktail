set -eu

APPDIR="${APPDIR:-$(CDPATH= cd -P "$(dirname -- "$0")" && pwd)}"

if [ -n "${SHARUN_DIR:-}" ] && [ -x "${APPDIR}/bin/bash" ]; then
  export MOCKTAIL_ANYLINUX_BIN_DIR="${APPDIR}/bin"
  export MOCKTAIL_BUNDLE_ROOT="${APPDIR}/usr/share/mocktail-bundle"
  exec "${APPDIR}/bin/bash" \
    "${MOCKTAIL_BUNDLE_ROOT}/mocktail/scripts/portable_launcher.sh" "$@"
fi

exec "${APPDIR}/usr/share/mocktail-bundle/run.sh" "$@"
