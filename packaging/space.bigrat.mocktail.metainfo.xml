<component type="desktop-application">
  <id>space.bigrat.mocktail</id>
  <name>Mocktail</name>
  <summary>Play Roblox on Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="space.bigrat">
    <name>Mocktail Project Authors</name>
  </developer>
  <url type="homepage">https://github.com/komaruworld/mocktail</url>
  <description>
    <p>
      Sign in to Roblox, browse experiences, and play them in a desktop window.
      Mocktail handles graphics, audio, mouse, and keyboard input on Linux.
    </p>
    <p>
      On first launch, Mocktail downloads the Roblox client and checks its
      signature. It keeps the last working version in case an update fails.
    </p>
    <p>
      Mocktail is an independent community project. It is not affiliated with
      or endorsed by Roblox Corporation, and the Roblox client is not included.
    </p>
  </description>
